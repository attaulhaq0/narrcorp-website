---
import { Image } from 'astro:assets';
import portrait from '../assets/talent-professional.webp';
import workflow from '../assets/workflow-illustration.webp';
import engineering from '../assets/engineering-illustration.webp';
import { homepage, services, ecosystemPlatforms } from '../data/homepage';
const ribbonPlatforms = ecosystemPlatforms.filter(({ name }) =>
  ['Azure', 'GitHub', 'Databricks', 'Snowflake'].includes(name),
);
const highlights = [
  {
    eyebrow: 'Engineering',
    service: services[2],
    image: engineering,
    alt: 'Application development workflow.',
    color: 'stone',
    action: 'Discuss software delivery',
  },
  {
    eyebrow: 'Automation',
    service: services[1],
    image: workflow,
    alt: 'Connected workflow for reviewing and routing tasks.',
    color: 'mint',
    action: 'Discuss your workflows',
  },
  {
    eyebrow: 'Talent',
    service: services[7],
    image: portrait,
    alt: 'Technology professional.',
    color: 'blue',
    action: 'Discuss your talent needs',
  },
];
---

<section
  id="services"
  class="container section services-section"
  aria-labelledby="services-heading"
>
  <div class="section-intro">
    <p class="section-label">Our services</p>
    <h2 id="services-heading">{homepage.services.headline}</h2>
    <p>{homepage.services.description}</p>
  </div>
  <div class="service-stack">
    {highlights.map(
      ({ eyebrow, service, image, alt, color, action }, index) => (
        <article
          class={`service-card service-card-${color}`}
          style={`--card-index: ${index}`}
        >
          <div class="service-card-copy">
            <span class="section-label">{eyebrow}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a class="button" href="#contact">
              {action}
            </a>
          </div>
          <div class="service-card-art">
            <Image
              src={image}
              alt={alt}
              width={700}
              height={650}
              sizes="(max-width: 760px) 100vw, 48vw"
              widths={[480, 800]}
              loading="lazy"
              quality={85}
            />
            {color === 'blue' && (
              <div class="service-skill-ribbons" aria-hidden="true">
                <div class="skill-ribbon">
                  {[0, 1].map(() => (
                    <div>
                      {ribbonPlatforms.map(({ name, asset }) => (
                        <span>
                          <img
                            src={`/media/platform-${asset}`}
                            alt=""
                            width="24"
                            height="24"
                          />
                          {name}
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      ),
    )}
  </div>
  <div class="service-directory">
    <div class="directory-heading">
      <h3>Explore the full offering.</h3>
      <p>Start with the challenge you need to solve.</p>
    </div>
    <div class="service-list">
      {services.map((service, index) => (
        <details class="service-detail">
          <summary>
            <span class="service-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{service.title}</span>
            <img src="/media/arrow-right.svg" alt="" width="20" height="20" />
          </summary>
          <div class="service-detail-body">
            <p>{service.description}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
