---
import Brand from './Brand.astro';
import { contact } from '../data/homepage';
---

<footer class="site-footer">
  <div class="container footer-navigation">
    <div>
      <h2>Technology</h2>
      <a href="#services">Engineering & automation</a>
      <a href="#services">Cloud & data</a>
      <a href="#services">Quality & resilience</a>
    </div>
    <div>
      <h2>People</h2>
      <a href="#expertise">Specialist expertise</a>
      <a href="#services">Staffing & dedicated teams</a>
      <a href="#guide-teams">Choosing an engagement</a>
    </div>
    <div>
      <h2>Narrcorp</h2>
      <a href="#about">About us</a>
      <a href="#why-narrcorp">Our approach</a>
      <a href="#guidance">Practical guidance</a>
      <a href="#project-questions">Project questions</a>
    </div>
    <div id="footer-contact">
      <h2>Start a conversation</h2>
      <a href={contact.href}>{contact.email}</a>
      <p>
        Technology projects
        <br />
        and hiring requirements.
      </p>
    </div>
  </div>
  <div class="container footer-inner">
    <Brand />
    <p>© {new Date().getFullYear()} Narrcorp. All rights reserved.</p>
    <details class="footer-privacy" id="privacy">
      <summary>Privacy</summary>
      <div class="footer-privacy-body">
        <h2>Website privacy</h2>
        <p>
          When you email Narrcorp, your message and contact details are used to
          respond to your enquiry and discuss the work you need. Please avoid
          sending passwords or sensitive records in an initial enquiry.
        </p>
        <p>
          Email and hosting providers process data to deliver messages and
          operate this website. Hosting data may include an IP address, browser
          information, pages requested and access times. Hostinger may also set
          a session cookie named <code>hcdn</code> when you visit.
        </p>
        <p>
          This website currently has no installed analytics or advertising
          trackers. For a question about your enquiry or website privacy, use
          the contact details in this footer.
        </p>
      </div>
    </details>
  </div>
</footer>
