---
import Brand from './Brand.astro';
import { contact } from '../data/homepage';
---

<footer class="site-footer">
  <div class="container footer-navigation">
    <div>
      <h2>Technology</h2>
      <a href="#services">Engineering & automation</a>
      <a href="#services">Cloud & data</a>
      <a href="#services">Quality & resilience</a>
    </div>
    <div>
      <h2>People</h2>
      <a href="#expertise">Specialist expertise</a>
      <a href="#services">Staffing & dedicated teams</a>
      <a href="#guide-teams">Choosing an engagement</a>
    </div>
    <div>
      <h2>Narrcorp</h2>
      <a href="#about">About us</a>
      <a href="#why-narrcorp">Our approach</a>
      <a href="#guidance">Practical guidance</a>
    </div>
    <div>
      <h2>Start a conversation</h2>
      <a href={contact.href}>{contact.email}</a>
      <p>
        Technology projects
        <br />
        and hiring requirements.
      </p>
    </div>
  </div>
  <div class="container footer-inner">
    <Brand />
    <p>© {new Date().getFullYear()} Narrcorp. All rights reserved.</p>
  </div>
  <div class="container footer-preferences" hidden>
    <label>
      <input
        type="checkbox"
        id="reduce-motion"
        aria-describedby="motion-help"
      />
      Reduce motion
    </label>
    <span class="sr-only" id="motion-help">
      Stop continuous animation and use simpler transitions. Your device's
      reduced-motion setting is also respected.
    </span>
  </div>
</footer>
<script>
  import {
    onMotionChange,
    setReducedMotionPreference,
  } from '../scripts/preferences';
  const preference = document.querySelector<HTMLInputElement>('#reduce-motion');
  if (preference) {
    preference.closest<HTMLElement>('.footer-preferences')!.hidden = false;
    onMotionChange((enabled) => (preference.checked = !enabled));
    preference.addEventListener('change', () =>
      setReducedMotionPreference(preference.checked),
    );
  }
</script>
