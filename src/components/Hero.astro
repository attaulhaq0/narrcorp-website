---
import { Image } from 'astro:assets';
import sculpture from '../assets/ribbon-sculpture.webp';
import { contact, homepage } from '../data/homepage';
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <h1 id="hero-heading">
      {homepage.hero.headline} <span>{homepage.hero.emphasis}</span>
    </h1>
    <p>{homepage.hero.description}</p>
    <div class="hero-actions">
      <a class="button" href={contact.href}>
        {homepage.hero.primaryAction}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#services">
        {homepage.hero.secondaryAction}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <Image
      src={sculpture}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(max-width: 760px) 100vw, 48vw"
      width={800}
      height={1200}
      loading="eager"
      fetchpriority="high"
      quality={85}
    />
  </div>
</section>
