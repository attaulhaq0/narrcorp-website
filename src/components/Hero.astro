---
import { homepage } from '../data/homepage';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-copy">
    <h1 id="hero-heading">
      {homepage.hero.headline} <em>{homepage.hero.emphasis}</em>
    </h1>
    <p>{homepage.hero.description}</p>
    <ul class="hero-points" aria-label="Our focus">
      <li>Technology consulting</li>
      <li>Software engineering</li>
      <li>Specialist talent</li>
    </ul>
    <a class="button hero-primary" href="#contact">
      {homepage.hero.primaryAction}
    </a>
  </div>
  <div class="hero-stage" aria-hidden="true">
    <video
      class="hero-sequence"
      width="2758"
      height="932"
      poster="/media/hero-sequence-desktop.webp"
      muted
      loop
      playsinline
      preload="none"
    ></video>
    <noscript>
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="/media/hero-sequence-mobile.webp"
        />
        <source
          media="(max-width: 991px)"
          srcset="/media/hero-sequence-tablet.webp"
        />
        <img
          src="/media/hero-sequence-desktop.webp"
          alt=""
          width="2758"
          height="932"
        />
      </picture>
    </noscript>
  </div>
  <div class="hero-bottom container">
    <a class="text-link" href="#services">
      {homepage.hero.secondaryAction}
      <img src="/media/arrow-right.svg" alt="" width="18" height="18" />
    </a>
  </div>
</section>
<script>
  import { isMotionEnabled, onMotionChange } from '../scripts/preferences';
  const video = document.querySelector<HTMLVideoElement>('.hero-sequence');
  if (video) {
    let paused = !isMotionEnabled();
    let activeFormat = '';
    video.closest('.hero-stage')?.classList.add('is-enhanced');
    const updateMotion = () => {
      if (paused) video.pause();
      else
        video.play().catch((error: unknown) => {
          if (error instanceof DOMException && error.name === 'AbortError')
            return;
          paused = true;
          updateMotion();
        });
    };
    const selectFormat = () => {
      const format =
        innerWidth <= 767 ? 'mobile' : innerWidth <= 991 ? 'tablet' : 'desktop';
      if (format === activeFormat) return;
      const position = video.currentTime;
      activeFormat = format;
      video.poster = `/media/hero-sequence-${format}.webp`;
      video.src = `/media/hero-sequence-${format}.mp4`;
      video.onloadedmetadata = () => {
        video.currentTime = Math.min(position, video.duration);
        updateMotion();
      };
      video.load();
    };
    selectFormat();
    onMotionChange((enabled) => {
      paused = !enabled;
      updateMotion();
    });
    window.addEventListener('resize', selectFormat);
  }
</script>
