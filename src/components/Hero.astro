---
import { contact, homepage } from '../data/homepage';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-copy">
    <h1 id="hero-heading">
      {homepage.hero.headline} <em>{homepage.hero.emphasis}</em>
    </h1>
    <p>{homepage.hero.description}</p>
    <ul class="hero-points" aria-label="Our focus">
      <li>Technology consulting</li>
      <li>Software engineering</li>
      <li>Specialist talent</li>
    </ul>
    <a class="button hero-primary" href={contact.href}>
      {homepage.hero.primaryAction}
    </a>
  </div>
  <div class="hero-stage" aria-hidden="true">
    <video
      class="hero-sequence"
      width="2758"
      height="932"
      poster="/media/hero-sequence-desktop.webp"
      muted
      loop
      playsinline
      preload="none"
    ></video>
    <noscript>
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="/media/hero-sequence-mobile.webp"
        />
        <source
          media="(max-width: 991px)"
          srcset="/media/hero-sequence-tablet.webp"
        />
        <img
          src="/media/hero-sequence-desktop.webp"
          alt=""
          width="2758"
          height="932"
        />
      </picture>
    </noscript>
  </div>
  <div class="hero-bottom container">
    <a class="text-link" href="#services">
      {homepage.hero.secondaryAction}
      <img src="/media/arrow-right.svg" alt="" width="18" height="18" />
    </a>
    <button class="motion-toggle" type="button" aria-pressed="false" hidden>
      Pause animation
    </button>
  </div>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-sequence');
  const motionToggle =
    document.querySelector<HTMLButtonElement>('.motion-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && motionToggle) {
    let paused = reducedMotion.matches;
    let activeFormat = '';
    let broadcastState: boolean | undefined;
    video.closest('.hero-stage')?.classList.add('is-enhanced');
    const updateMotion = () => {
      if (paused) video.pause();
      else
        video.play().catch((error: unknown) => {
          if (error instanceof DOMException && error.name === 'AbortError')
            return;
          paused = true;
          updateMotion();
        });
      motionToggle.setAttribute('aria-pressed', String(paused));
      motionToggle.textContent = paused ? 'Play animation' : 'Pause animation';
      if (broadcastState !== !paused) {
        broadcastState = !paused;
        document.dispatchEvent(
          new CustomEvent('narrcorp:motion', { detail: { enabled: !paused } }),
        );
      }
    };
    const selectFormat = () => {
      const format =
        innerWidth <= 767 ? 'mobile' : innerWidth <= 991 ? 'tablet' : 'desktop';
      if (format === activeFormat) return;
      const position = video.currentTime;
      activeFormat = format;
      video.poster = `/media/hero-sequence-${format}.webp`;
      video.src = `/media/hero-sequence-${format}.mp4`;
      video.onloadedmetadata = () => {
        video.currentTime = Math.min(position, video.duration);
        updateMotion();
      };
      video.load();
    };
    motionToggle.hidden = false;
    selectFormat();
    updateMotion();
    window.addEventListener('resize', selectFormat);
    motionToggle.addEventListener('click', () => {
      paused = !paused;
      updateMotion();
    });
    reducedMotion.addEventListener('change', (event) => {
      paused = event.matches;
      updateMotion();
    });
  }
</script>
