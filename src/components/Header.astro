---
import Brand from './Brand.astro';
import { contact, navigation } from '../data/homepage';
---

<div class="announcement">
  <img src="/media/automation-object.webp" alt="" width="48" height="48" />
  <img
    class="announcement-separator"
    src="/media/sparkle.svg"
    alt=""
    width="14"
    height="14"
  />
  <p>Technology services and specialist staffing, connected.</p>
  <img
    class="announcement-separator"
    src="/media/sparkle.svg"
    alt=""
    width="14"
    height="14"
  />
  <a href="#services" aria-label="Explore services">
    Explore services{' '}
    <img src="/media/arrow-right.svg" alt="" width="20" height="20" />
  </a>
</div>
<header class="site-header">
  <div class="container header-inner">
    <Brand />
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
      hidden
    >
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <nav
      id="primary-navigation"
      class="primary-navigation"
      aria-label="Main navigation"
    >
      {navigation.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
      <a href="#industries">Industry scenarios</a>
      <a href="#guidance">Guidance</a>
    </nav>
    <div class="header-actions">
      <a class="button button-small button-outline" href="#expertise">
        Explore expertise
      </a>
      <a class="button button-small" href={contact.href}>
        Email Narrcorp
      </a>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.primary-navigation');
  const compact = window.matchMedia('(max-width: 1100px)');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Close navigation' : 'Open navigation',
      );
      nav.classList.toggle('is-open', open);
      toggle.querySelector('.menu-label')!.textContent = open
        ? 'Close'
        : 'Menu';
    };
    toggle.hidden = false;
    nav.classList.add('is-enhanced');
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    nav.addEventListener('click', (event) => {
      if (
        compact.matches &&
        event.target instanceof Element &&
        event.target.closest('a')
      )
        setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (
        event.target instanceof Node &&
        !nav.contains(event.target) &&
        !toggle.contains(event.target)
      )
        setOpen(false);
    });
    compact.addEventListener('change', () => setOpen(false));
  }
</script>
