---
import { homepage, principles } from '../data/homepage';
---

<section id="why-narrcorp" class="why-section" aria-labelledby="why-heading">
  <div class="container section why-inner">
    <div class="why-intro">
      <p class="section-label">Why Narrcorp</p>
      <h2
        id="why-heading"
        data-scroll-highlight
        aria-label={homepage.why.headline}
      >
        {homepage.why.headline}
      </h2>
      <img
        class="why-object"
        src="/media/connected-object.webp"
        alt=""
        width="280"
        height="280"
        loading="lazy"
      />
      <p class="why-object-caption">
        Connect the work, the systems and the skills.
      </p>
    </div>
    <ol class="principle-list">
      {principles.map((principle, index) => (
        <li>
          <span class="principle-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
