---
import { Image } from 'astro:assets';
import portrait from '../assets/talent-professional.webp';
import { contact, homepage } from '../data/homepage';
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container section contact-inner">
    <div class="contact-copy">
      <p class="section-label">Let's talk</p>
      <h2 id="contact-heading">{homepage.cta.headline}</h2>
      <p>{homepage.cta.description}</p>
      <a class="button" href={contact.href}>
        {homepage.cta.action}
      </a>
      <a class="contact-email" href={contact.href}>
        {contact.email}
      </a>
    </div>
    <div class="contact-art" aria-hidden="true">
      <Image
        src={portrait}
        alt=""
        width={650}
        height={720}
        widths={[480, 800]}
        sizes="(max-width: 760px) 100vw, 48vw"
        loading="lazy"
        quality={85}
      />
      <span class="contact-chip chip-one">A project to deliver.</span>
      <span class="contact-chip chip-two">A team to strengthen.</span>
      <span class="contact-chip chip-three">A place to start.</span>
    </div>
  </div>
</section>
