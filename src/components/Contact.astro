---
import { Image } from 'astro:assets';
import portrait from '../assets/contact-distinct-face.webp';
import { contact, homepage } from '../data/homepage';
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container section contact-inner">
    <div class="contact-copy">
      <p class="section-label">Let's talk</p>
      <h2 id="contact-heading">{homepage.cta.headline}</h2>
      <p>{homepage.cta.description}</p>
      <a class="button" href={contact.href}>
        {homepage.cta.action}
      </a>
    </div>
    <div class="contact-art">
      <div class="engagement-track">
        <div class="engagement-card">
          <Image
            src={portrait}
            alt=""
            width={72}
            height={72}
            loading="lazy"
            quality={85}
          />
          <span class="section-label">Specialist support</span>
          <h3>Strengthen your team.</h3>
          <p>Define the skills, responsibilities and working arrangement.</p>
          <div class="engagement-tags">
            <span>Staff augmentation</span>
            <span>Permanent hiring</span>
          </div>
        </div>
        <div class="engagement-card">
          <img
            class="engagement-icon"
            src="/media/code-xml.svg"
            alt=""
            width="36"
            height="36"
          />
          <span class="section-label">Project delivery</span>
          <h3>Move the work forward.</h3>
          <p>Agree the scope, review points and operating needs.</p>
          <div class="engagement-tags">
            <span>Engineering</span>
            <span>Automation</span>
          </div>
        </div>
        <div class="engagement-card">
          <img
            class="engagement-icon"
            src="/media/users.svg"
            alt=""
            width="36"
            height="36"
          />
          <span class="section-label">Dedicated teams</span>
          <h3>Bring the right skills together.</h3>
          <p>
            Discuss the disciplines and ownership your delivery effort needs.
          </p>
          <div class="engagement-tags">
            <span>Team planning</span>
            <span>Technical expertise</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
