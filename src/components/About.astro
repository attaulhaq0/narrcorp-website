---
import { Image } from 'astro:assets';
import collaboration from '../assets/collaboration-team.webp';
import { homepage } from '../data/homepage';
---

<section
  id="about"
  class="container section about-section"
  aria-labelledby="about-heading"
>
  <div class="section-intro">
    <p class="section-label">About Narrcorp</p>
    <h2 id="about-heading">{homepage.about.headline}</h2>
  </div>
  <div class="about-body">
    <div class="about-copy">
      {homepage.about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="about-photo">
      <Image
        src={collaboration}
        alt="Two technology professionals reviewing work together."
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 52vw"
        width={900}
        height={600}
        loading="lazy"
        quality={85}
      />
      <div class="overview-metrics">
        <div>
          <strong>08</strong>
          <span>Technology service areas</span>
        </div>
        <div>
          <strong>03</strong>
          <span>
            Staff augmentation, permanent hiring
            <br />
            and dedicated teams
          </span>
        </div>
        <div>
          <strong>04</strong>
          <span>Delivery principles to guide the work</span>
        </div>
      </div>
      <span class="image-chip">Advice. Delivery. People.</span>
    </div>
  </div>
</section>
