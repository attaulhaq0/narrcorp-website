---
import { Image } from 'astro:assets';
import collaboration from '../assets/collaboration-team.webp';
import { homepage } from '../data/homepage';
---

<section
  id="about"
  class="container section about-section"
  aria-labelledby="about-heading"
>
  <div class="section-intro">
    <p class="section-label">About Narrcorp</p>
    <h2 id="about-heading">{homepage.about.headline}</h2>
  </div>
  <div class="about-body">
    <div class="about-copy">
      {homepage.about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="about-photo">
      <Image
        src={collaboration}
        alt="Illustrative image of two technology professionals reviewing work together."
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 52vw"
        width={900}
        height={600}
        loading="lazy"
        quality={85}
      />
      <span class="image-chip">Advice. Delivery. People.</span>
    </div>
  </div>
</section>
