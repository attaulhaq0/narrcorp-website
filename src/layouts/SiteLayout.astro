---
import '../styles/global.css';
import { homepage, contact, services } from '../data/homepage';
interface Props {
  title?: string;
  description?: string;
}
const { title = homepage.title, description = homepage.description } =
  Astro.props;
const isError = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404';
const canonical = 'https://narrcorp.com/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': canonical + '#organization',
      name: 'Narrcorp',
      url: canonical,
      email: contact.email,
      description: homepage.description,
      hasOfferCatalog: { '@id': canonical + '#services-catalog' },
    },
    {
      '@type': 'WebSite',
      '@id': canonical + '#website',
      url: canonical,
      name: 'Narrcorp',
      publisher: { '@id': canonical + '#organization' },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': canonical + '#website' },
      about: { '@id': canonical + '#organization' },
      inLanguage: 'en',
    },
    {
      '@type': 'OfferCatalog',
      '@id': canonical + '#services-catalog',
      name: 'Narrcorp technology and talent services',
      itemListElement: services.map((service) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: service.title,
          description: service.description,
          provider: { '@id': canonical + '#organization' },
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        isError ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    {!isError && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#132128" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Narrcorp" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta
      property="og:image"
      content="https://narrcorp.com/social-preview.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Narrcorp — Technology consulting, engineering and specialist talent."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://narrcorp.com/social-preview.jpg"
    />
    {!isError && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
